class Solution {
public:

    void solve(vector<int>& ans, Node* root) {
        if (root == nullptr) {
            return;
        }

        // Visit root first
        ans.push_back(root->val);

        // Visit all children
        int n = root->children.size();

        for (int i = 0; i < n; i++) {
            solve(ans, root->children[i]);
        }
    }

    vector<int> preorder(Node* root) {
        vector<int> ans;

        solve(ans, root);

        return ans;
    }
};
